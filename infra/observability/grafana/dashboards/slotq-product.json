{
  "uid": "slotq-product",
  "title": "SlotQ Product — requests, DB delivery and effects",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "slotq",
    "product"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Request rate by server route",
      "type": "timeseries",
      "description": "Server route templates only. No tenant, request or raw URL labels.",
      "datasource": {
        "type": "prometheus",
        "uid": "slotq-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route,method,status_class) (rate(slotq_http_requests_seconds_count[5m]))",
          "legendFormat": "{{delivery_state}}{{promotion_outcome}}{{outcome}}{{sample}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "NO SIGNAL / UNKNOWN"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Request latency p95",
      "type": "timeseries",
      "description": "Approximate request p95 using explicit SLO buckets: 100ms, 500ms, 1s, 5s, 10s. Not event commit/effect latency; insufficient observations remain unknown.",
      "datasource": {
        "type": "prometheus",
        "uid": "slotq-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,route) (rate(slotq_http_requests_seconds_bucket[5m])))",
          "legendFormat": "{{delivery_state}}{{promotion_outcome}}{{outcome}}{{sample}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "NO SIGNAL / UNKNOWN"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Request failure classification",
      "type": "timeseries",
      "description": "Business conflicts, authorization errors, DB deadlock/timeout/connection and internal failure remain distinct.",
      "datasource": {
        "type": "prometheus",
        "uid": "slotq-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(slotq_http_requests_seconds_count{status_class=~\"4xx|5xx\"}[5m]))",
          "legendFormat": "{{delivery_state}}{{promotion_outcome}}{{outcome}}{{sample}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO SIGNAL / UNKNOWN"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Observer freshness",
      "type": "timeseries",
      "description": "Two independent domains: events and locks. NaN means no successful sample.",
      "datasource": {
        "type": "prometheus",
        "uid": "slotq-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slotq_observation_sample_age_seconds",
          "legendFormat": "{{delivery_state}}{{promotion_outcome}}{{outcome}}{{sample}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "NO SIGNAL / UNKNOWN"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Observer healthy",
      "type": "timeseries",
      "description": "0 means unavailable/stale. Query panels must not interpret NaN or absent series as healthy 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "slotq-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slotq_observation_sample_healthy",
          "legendFormat": "{{delivery_state}}{{promotion_outcome}}{{outcome}}{{sample}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO SIGNAL / UNKNOWN"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Sample truncation",
      "type": "timeseries",
      "description": "1 means cap of 10000 reached. Counts are lower bounds, receipts are inventory and not throughput.",
      "datasource": {
        "type": "prometheus",
        "uid": "slotq-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slotq_db_sample_truncated",
