      "type": "timeseries",
      "description": "Separate original registration targets: PENDING PROCESSING DONE DEAD. Oldest-first, independently capped per state.",
      "datasource": {
        "type": "prometheus",
        "uid": "slotq-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
